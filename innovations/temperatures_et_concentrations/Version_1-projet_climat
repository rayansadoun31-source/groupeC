import math

# =============================================================================
# CONSTANTES PHYSIQUES ET CONFIGURATION (ISA)
# =============================================================================
G = 9.80665      # Pesanteur (m/s²)
M = 0.0289644    # Masse molaire de l'air (kg/mol)
R = 8.31445      # Constante des gaz parfaits (J/mol/K)
P0 = 101325.0    # Pression au sol (Pa)
T0 = 288.15      # Température au sol (K)

# Structure de l'atmosphère : (Altitude_max_km, Température_base_°C, Gradient_K/km)
ISA_LAYERS = [
    (11.0,  15.0,  -6.5),   # Troposphère
    (20.0, -56.5,   0.0),   # Stratosphère basse
    (32.0, -56.5,   1.0),   # Stratosphère moyenne
    (50.0, -44.5,   2.8),   # Stratosphère haute
    (71.0,   5.9,  -2.8),   # Mésosphère basse
    (85.0, -52.9,  -2.0),   # Mésosphère haute
    (100.0, -80.9, 12.0)    # Thermosphère basse
]

# Registre des gaz bien brassés (Homosphère) et leurs concentrations (en ppm)
GAS_REGIME = {
    "CO2": 425.0,
    "CH4": 1.91,
    "N2O": 0.33
}

# =============================================================================
# FONCTIONS DE CALCUL
# =============================================================================

def get_temperature_isa(z_km: float) -> float:
    """Calcule la température locale en Kelvin (K) à l'altitude z_km."""
    z_base = 0.0
    for z_max, t_base_c, alpha in ISA_LAYERS:
        if z_km <= z_max:
            return (t_base_c + alpha * (z_km - z_base)) + 273.15
        z_base = z_max
    return (ISA_LAYERS[-1][1] + ISA_LAYERS[-1][2] * (z_km - z_base)) + 273.15


def get_pressure_isa(z_km: float) -> float:
    """Calcule la pression atmosphérique locale (en Pa) à l'altitude z_km."""
    p_current = P0
    z_base = 0.0
    
    for z_max, t_base_c, alpha in ISA_LAYERS:
        z_end = min(z_km, z_max)
        dz_m = (z_end - z_base) * 1000.0
        
        t_start_k = t_base_c + 273.15
        alpha_m = alpha / 1000.0
        
        if alpha_m != 0.0:
            t_final_k = t_start_k + alpha_m * dz_m
            p_current *= math.pow(t_final_k / t_start_k, (-G * M) / (R * alpha_m))
        else:
            p_current *= math.exp((-G * M * dz_m) / (R * t_start_k))
            
        if z_km <= z_max:
            break
        z_base = z_max
        
    return p_current


def get_gas_concentration(z_km: float, gas_name: str) -> dict:
    """Calcule la concentration relative (PPM mélange) et absolue d'un gaz."""
    gas = gas_name.upper()
    t_k = get_temperature_isa(z_km)
    p_pa = get_pressure_isa(z_km)
    
    if gas in GAS_REGIME:
        ppm_melange = GAS_REGIME[gas]
    elif gas == "O3":
        # Profil en cloche de l'ozone (pic stratosphérique vers 25 km)
        if 15.0 <= z_km <= 35.0:
            ppm_melange = 8.0 * math.exp(-((z_km - 25.0) / 5.0)**2)
        else:
            ppm_melange = 0.1
    else:
        raise ValueError("Gaz non pris en compte. Choisissez : CO2, CH4, N2O ou O3.")

    # Loi des gaz parfaits pour la correction de raréfaction de l'air
    ppm_vol_abs = ppm_melange * (p_pa / P0) * (T0 / t_k)
    
    return {
        "Altitude": z_km,
        "Gaz": gas,
        "Temp_C": round(t_k - 273.15, 2),
        "Pression_Pa": round(p_pa, 1),
        "PPM_Melange": ppm_melange,
        "PPM_Vol_Abs": round(ppm_vol_abs, 3)
    }

# =============================================================================
# BLOC D'ÉCUTION (Indispensable pour Visual Studio)
# =============================================================================
if __name__ == "__main__":
    print("--- VÉRIFICATION DU MODÈLE ATMOSPHÉRIQUE ---")
    scenarios = [(0.0, "CO2"), (11.0, "CH4"), (25.0, "O3")]
    
    for alt, g in scenarios:
        res = get_gas_concentration(alt, g)
        print(f"[{res['Gaz']}] à {res['Altitude']} km -> "
              f"Temp: {res['Temp_C']}°C | "
              f"P: {res['Pression_Pa']} Pa | "
              f"PPM Mix: {res['PPM_Melange']} | "
              f"PPM Vol Abs: {res['PPM_Vol_Abs']}")

